# ─────────────────────────────────────────────────────────────
#  WhOM backend configuration
#  Local (XAMPP):  copy this file to  .env  and edit it.
#  Production:     DO NOT upload .env — set these as environment
#                  variables in the Render dashboard instead.
# ─────────────────────────────────────────────────────────────

# local | production.  "local" relaxes the JWT_SECRET length check.
APP_ENV=local
# true shows real error messages in API responses. Keep false in production.
APP_DEBUG=false

# ── Database ────────────────────────────────────────────────
# XAMPP defaults: user root, empty password. Create the database first:
#   phpMyAdmin → New → name "whom", collation utf8mb4_unicode_ci
DB_HOST=bohfh5qt1pp6j5jgjvk3-mysql.services.clever-cloud.com
DB_PORT=3306
DB_NAME=bohfh5qt1pp6j5jgjvk3
DB_USER=ukeap4iybj84x5aj
DB_PASSWORD=ySdhLQxB58SwbBtYnp1d

# Clever Cloud MySQL: you do NOT need to rename anything. If DB_* above are
# unset, the backend automatically reads the add-on's own variables:
#   MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_DB,
#   MYSQL_ADDON_USER, MYSQL_ADDON_PASSWORD
# (copy them from the add-on's "Information" tab into Render's env vars).
# Optional, only if your provider requires TLS: path to a CA bundle.
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Create tables automatically on first request / container start.
AUTO_MIGRATE=true

# ── Auth ────────────────────────────────────────────────────
# REQUIRED. 32+ random characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing it logs every user out.
JWT_SECRET=w1h2o3m-w1h2o3m-w1h2o3m-w1h2o3m-w1h2o3m-w1h2o3m-w1h2o3m
JWT_TTL_DAYS=7

# ── CORS ────────────────────────────────────────────────────
# Same-origin setup (backend serves the frontend: XAMPP or the Docker image)
# needs NOTHING here — leave empty.
# Only set this if the frontend is hosted somewhere else (GitHub Pages, Netlify…):
#   *                                   any origin (dev only)
#   https://you.github.io,https://shop.example.com   exact origins, comma-separated
CORS_ORIGINS=

# ── Misc ────────────────────────────────────────────────────
# Used to decide what "today" means on the dashboard.
APP_TIMEZONE=Africa/Lagos
# Prefix added to local phone numbers that start with 0 (234 = Nigeria).
DEFAULT_COUNTRY_CODE=234
DEFAULT_CURRENCY=₦
# true when behind Render's proxy, so rate limiting sees the real client IP.
TRUST_PROXY=false
# Brute-force / spam protection on login, register and checkout.
RATE_LIMIT=true

# Optional Paystack secret for server-side online payment initialization/verification.
PAYSTACK_SECRET_KEY=sk_test_6950fc340ab5fa0bd329cf655566f9a2d5e26fda
